{
  "name": "blazerrouter-cli",
  "version": "0.1.0",
  "description": "CLI oficial do BlazerRouter para acessar modelos de IA pelo terminal.",
  "type": "module",
  "bin": {
    "blazer": "./dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node20 --clean",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["blazerrouter", "ai", "cli", "llm", "openai-compatible"],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.8.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
